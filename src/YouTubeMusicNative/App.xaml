<Application x:Class="YouTubeMusicNative.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:YouTubeMusicNative.Services"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views"
             xmlns:vm="clr-namespace:YouTubeMusicNative.ViewModels"
             xmlns:api="clr-namespace:YouTubeMusicNative.Api"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ================================================================ Palette -->
        <Color x:Key="AccentColor">#FF3355</Color>
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="Panel" Color="#121212"/>
        <SolidColorBrush x:Key="Elevated" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="ElevatedHover" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Menu" Color="#282828"/>
        <SolidColorBrush x:Key="MenuHover" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="RowHover" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="RowSelected" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="Divider" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDim" Color="#B3B3B3"/>
        <SolidColorBrush x:Key="TextFaint" Color="#727272"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF5571"/>
        <SolidColorBrush x:Key="SliderTrack" Color="#4DFFFFFF"/>

        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- ================================================================ Converters -->
        <s:ThumbnailConverter x:Key="Thumb"/>
        <s:TimeConverter x:Key="Time"/>
        <s:NullToVisibilityConverter x:Key="Vis"/>
        <s:BoolToGlyphConverter x:Key="BoolGlyph"/>
        <s:RepeatGlyphConverter x:Key="RepeatGlyph"/>
        <s:RepeatActiveConverter x:Key="RepeatActive"/>
        <s:VolumeGlyphConverter x:Key="VolumeGlyph"/>
        <s:EnumEqualsConverter x:Key="IsPage"/>
        <s:EqualsMultiConverter x:Key="EqualsMulti"/>
        <s:LikedConverter x:Key="Liked"/>
        <s:FractionConverter x:Key="Fraction"/>
        <s:ColorToBrushConverter x:Key="ColorBrush"/>
        <s:IndexConverter x:Key="Index"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- ================================================================ Text -->
        <Style x:Key="Hero" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Pages fade in when they appear -->
        <Style x:Key="PageRoot" TargetType="FrameworkElement">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================================================================ Buttons -->
        <Style x:Key="FocusNone" TargetType="Control">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- Plain glyph button: dim, brightens on hover -->
        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle (shuffle / repeat / queue / now-playing): accent + dot when on -->
        <Style x:Key="ModeToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{StaticResource Accent}" VerticalAlignment="Bottom"
                                     HorizontalAlignment="Center" Margin="0,0,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White circular play/pause -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big accent play (page headers, cards) -->
        <Style x:Key="AccentPlayButton" TargetType="Button" BasedOn="{StaticResource PlayButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <!-- Solid / outline pills -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Filled accent pill for a dialog's main (destructive) action -->
        <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="OutlinePill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#7C7C7C"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Round grey buttons in the top bar (home, back, forward, account) -->
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="{StaticResource Elevated}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="{StaticResource ElevatedHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallCircleButton" TargetType="Button" BasedOn="{StaticResource CircleButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#B3000000"/>
        </Style>

        <!-- Caption buttons -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Whole-card / whole-row buttons -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#535353">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="Black" HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================ Slider (seek / volume) -->
        <Style x:Key="SliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="{TemplateBinding Foreground}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="{StaticResource SliderTrack}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="12">
                                    <Thumb.Template>
                                        <!-- The thumb also draws the track under itself so there's no gap when the knob is hidden -->
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Border Height="4" Width="6" HorizontalAlignment="Left"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                                <Border Height="4" Width="6" HorizontalAlignment="Right" Background="{StaticResource SliderTrack}"/>
                                                <Ellipse Fill="White"
                                                         Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource BoolVis}}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================================================================ Scrollbars -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="#4DFFFFFF" CornerRadius="5" Margin="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#80FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================================================================ Lists -->
        <Style x:Key="TrackItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <v:TrackContainerStyleSelector x:Key="TrackContainers" TrackStyle="{StaticResource TrackItem}" HeaderStyle="{StaticResource HeaderItem}"/>

        <Style x:Key="TrackList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyleSelector" Value="{StaticResource TrackContainers}"/>
            <Setter Property="AlternationCount" Value="1000000"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- ================================================================ Menus & tooltips -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Menu}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="200">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Glyph}"
                                           FontSize="15" Width="18" Margin="0,0,12,0" Foreground="{StaticResource TextDim}"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#3E3E3E" Margin="4,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource Menu}" CornerRadius="4" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================ Text input -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Elevated}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="23">
                            <Grid>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="18" HorizontalAlignment="Left"
                                           Margin="14,0,0,0" Foreground="{StaticResource TextDim}"/>
                                <TextBlock x:Name="Placeholder" Text="What do you want to play?" Foreground="{StaticResource TextFaint}"
                                           VerticalAlignment="Center" Margin="46,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="44,0,40,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ElevatedHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E3E3E"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Elevated}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================================ Shared templates -->

        <!-- Rounded album art from a Track/MediaItem/PlaylistInfo "ThumbnailUrl" -->
        <Style x:Key="Art" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{StaticResource Elevated}"/>
        </Style>

        <!-- Track actions, shared by row right-click and the row "…" button. PlacementTarget.Tag = page view model. -->
        <ContextMenu x:Key="TrackMenu" x:Shared="False">
            <MenuItem Header="Play next" Tag="&#xE72A;"
                      Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Add to queue" Tag="&#xE710;"
                      Command="{Binding PlacementTarget.Tag.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="Start radio" Tag="&#xE8D6;"
                      Command="{Binding PlacementTarget.Tag.StartRadioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <Separator Visibility="{Binding IsLoggedIn, Source={x:Static vm:LibraryActions.Instance}, Converter={StaticResource BoolVis}}"/>
            <MenuItem Command="{Binding ToggleLikeCommand, Source={x:Static vm:LibraryActions.Instance}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsLoggedIn, Source={x:Static vm:LibraryActions.Instance}, Converter={StaticResource BoolVis}}">
                <MenuItem.Header>
                    <MultiBinding Converter="{StaticResource Liked}" ConverterParameter="Remove from Liked Music|Save to Liked Music">
                        <Binding Path="VideoId"/>
                        <Binding Path="LikesVersion" Source="{x:Static vm:LibraryActions.Instance}"/>
                    </MultiBinding>
                </MenuItem.Header>
                <MenuItem.Tag>
                    <MultiBinding Converter="{StaticResource Liked}" ConverterParameter="&#xE00B;|&#xE006;">
                        <Binding Path="VideoId"/>
                        <Binding Path="LikesVersion" Source="{x:Static vm:LibraryActions.Instance}"/>
                    </MultiBinding>
                </MenuItem.Tag>
            </MenuItem>
            <MenuItem Header="Add to playlist…" Tag="&#xE8F4;"
                      Command="{Binding AddToPlaylistCommand, Source={x:Static vm:LibraryActions.Instance}}" CommandParameter="{Binding}"
                      Visibility="{Binding IsLoggedIn, Source={x:Static vm:LibraryActions.Instance}, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Remove from this playlist" Tag="&#xE74D;"
                      Command="{Binding PlacementTarget.Tag.RemoveFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding PlacementTarget.Tag.CanRemoveTracks, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
        </ContextMenu>

        <!-- Numbered track row: # / title+artist / album / … / duration -->
        <DataTemplate x:Key="TrackRow" DataType="{x:Type api:Track}">
            <Grid x:Name="Root" Height="56" Background="Transparent"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  ContextMenu="{StaticResource TrackMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Num" Style="{StaticResource Sub}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>

                <Grid Grid.Column="1" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ArtBox" Width="40" Height="40" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Art}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Thumb}, ConverterParameter=40}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <!-- Play on hover; for the current song it shows play / pause and toggles playback -->
                    <Border x:Name="ArtOverlay" CornerRadius="4" Background="#A6000000" Visibility="Collapsed">
                        <Grid>
                            <Button x:Name="ArtPlay" Style="{StaticResource IconButton}" Width="40" Height="40"
                                    Content="&#xE768;" Foreground="White" FontSize="16" ToolTip="Play"
                                    Command="{Binding Tag.ArtPlayCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                            <v:Spinner x:Name="ArtSpinner" Width="18" Height="18" Thickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{Binding Title}" Style="{StaticResource Title}" FontWeight="Normal" FontSize="15"/>
                        <TextBlock Text="{Binding Artists}" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding Album}" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="Heart" Style="{StaticResource IconButton}" Visibility="Hidden" FontSize="15"
                            Command="{Binding ToggleLikeCommand, Source={x:Static vm:LibraryActions.Instance}}" CommandParameter="{Binding}">
                        <Button.Content>
                            <MultiBinding Converter="{StaticResource Liked}" ConverterParameter="&#xE00B;|&#xE006;">
                                <Binding Path="VideoId"/>
                                <Binding Path="LikesVersion" Source="{x:Static vm:LibraryActions.Instance}"/>
                            </MultiBinding>
                        </Button.Content>
                        <Button.ToolTip>
                            <MultiBinding Converter="{StaticResource Liked}" ConverterParameter="Remove from Liked Music|Save to Liked Music">
                                <Binding Path="VideoId"/>
                                <Binding Path="LikesVersion" Source="{x:Static vm:LibraryActions.Instance}"/>
                            </MultiBinding>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="More" Style="{StaticResource IconButton}" Content="&#xE712;" Visibility="Hidden"
                            ToolTip="More options" v:ListBehaviors.OpenMenuOnClick="True"
                            Tag="{Binding Tag, ElementName=Root}" ContextMenu="{StaticResource TrackMenu}"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Sub}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,20,0"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                            <Binding Path="VideoId"/>
                            <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="ArtOverlay" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding Path="VideoId"/>
                                    <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsPaused, ElementName=Root}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtOverlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ArtPlay" Property="Content" Value="&#xE995;"/>
                    <Setter TargetName="ArtPlay" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter TargetName="ArtPlay" Property="ToolTip" Value="Pause"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding Path="VideoId"/>
                                    <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsPaused, ElementName=Root}" Value="False"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtPlay" Property="Content" Value="&#xE769;"/>
                    <Setter TargetName="ArtPlay" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding Path="VideoId"/>
                                    <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsPaused, ElementName=Root}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtOverlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ArtPlay" Property="ToolTip" Value="Resume"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding Path="VideoId"/>
                                    <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsBuffering, ElementName=Root}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtOverlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ArtPlay" Property="Opacity" Value="0"/>
                    <Setter TargetName="ArtSpinner" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="More" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Heart" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource Liked}">
                            <Binding Path="VideoId"/>
                            <Binding Path="LikesVersion" Source="{x:Static vm:LibraryActions.Instance}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="Heart" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Heart" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoggedIn, Source={x:Static vm:LibraryActions.Instance}}" Value="False">
                    <Setter TargetName="Heart" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Compact row for the queue panel / now-playing list -->
        <DataTemplate x:Key="QueueRow" DataType="{x:Type api:Track}">
            <Grid x:Name="Root" Height="56" Background="Transparent"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play" Tag="&#xE768;"
                                  Command="{Binding PlacementTarget.Tag.PlayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Remove from queue" Tag="&#xE711;"
                                  Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Border Style="{StaticResource Art}" Width="44" Height="44" Margin="8,0,0,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Thumb}, ConverterParameter=44}" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border x:Name="ArtLoading" CornerRadius="4" Background="#99000000" Visibility="Collapsed">
                        <v:Spinner Width="20" Height="20" Thickness="2"/>
                    </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Style="{StaticResource Title}" FontWeight="Normal" FontSize="14"/>
                    <TextBlock Text="{Binding Artists}" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="Remove" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                        Margin="0,0,6,0" Visibility="Hidden" ToolTip="Remove"
                        Command="{Binding Tag.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                            <Binding/>
                            <Binding Path="Tag.Queue.Current" ElementName="Root"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding/>
                                    <Binding Path="Tag.Queue.Current" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsBuffering, ElementName=Root}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtLoading" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!-- Narrow song row (mini player drawer): art / title+artist / heart / length. Tag = the list's view model. -->
        <DataTemplate x:Key="CompactTrackRow" DataType="{x:Type api:Track}">
            <Grid x:Name="Root" Height="52" Background="Transparent"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                  ContextMenu="{StaticResource TrackMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="ArtBox" Width="40" Height="40" Margin="8,0,0,0" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Art}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Thumb}, ConverterParameter=40}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <!-- Play on hover; for the current song it shows play / pause and toggles playback -->
                    <Border x:Name="ArtOverlay" CornerRadius="4" Background="#A6000000" Visibility="Collapsed">
                        <Grid>
                            <Button x:Name="ArtPlay" Style="{StaticResource IconButton}" Width="40" Height="40"
                                    Content="&#xE768;" Foreground="White" FontSize="16" ToolTip="Play"
                                    Command="{Binding Tag.ArtPlayCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                            <v:Spinner x:Name="ArtSpinner" Width="18" Height="18" Thickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Style="{StaticResource Title}" FontWeight="Normal" FontSize="14"/>
                    <TextBlock Text="{Binding Artists}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="Heart" Grid.Column="2" Style="{StaticResource IconButton}" Visibility="Hidden" FontSize="13" Width="30" Height="30"
                        Command="{Binding ToggleLikeCommand, Source={x:Static vm:LibraryActions.Instance}}" CommandParameter="{Binding}">
                    <Button.Content>
                        <MultiBinding Converter="{StaticResource Liked}" ConverterParameter="&#xE00B;|&#xE006;">
                            <Binding Path="VideoId"/>
                            <Binding Path="LikesVersion" Source="{x:Static vm:LibraryActions.Instance}"/>
                        </MultiBinding>
                    </Button.Content>
                </Button>
                <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                            <Binding Path="VideoId"/>
                            <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="ArtOverlay" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding Path="VideoId"/>
                                    <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsPaused, ElementName=Root}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtOverlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ArtPlay" Property="Content" Value="&#xE995;"/>
                    <Setter TargetName="ArtPlay" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter TargetName="ArtPlay" Property="ToolTip" Value="Pause"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding Path="VideoId"/>
                                    <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsPaused, ElementName=Root}" Value="False"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtPlay" Property="Content" Value="&#xE769;"/>
                    <Setter TargetName="ArtPlay" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding Path="VideoId"/>
                                    <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsPaused, ElementName=Root}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtOverlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ArtPlay" Property="ToolTip" Value="Resume"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource EqualsMulti}">
                                    <Binding Path="VideoId"/>
                                    <Binding Path="Tag.Playback.NowPlaying.VideoId" ElementName="Root"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding Tag.Playback.IsBuffering, ElementName=Root}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ArtOverlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ArtPlay" Property="Opacity" Value="0"/>
                    <Setter TargetName="ArtSpinner" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Heart" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource Liked}">
                            <Binding Path="VideoId"/>
                            <Binding Path="LikesVersion" Source="{x:Static vm:LibraryActions.Instance}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="Heart" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Heart" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoggedIn, Source={x:Static vm:LibraryActions.Instance}}" Value="False">
                    <Setter TargetName="Heart" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Application.Resources>
</Application>
