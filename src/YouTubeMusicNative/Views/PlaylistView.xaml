<UserControl x:Class="YouTubeMusicNative.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views"
             xmlns:vm="clr-namespace:YouTubeMusicNative.ViewModels"
             xmlns:api="clr-namespace:YouTubeMusicNative.Api"
             Style="{StaticResource PageRoot}">
    <Grid>
        <!-- Colour wash from the cover art behind the header and the top of the list -->
        <Border Height="460" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{Binding HeaderColor}" Offset="0"/>
                    <GradientStop Color="{Binding HeaderColor}" Offset="0.45"/>
                    <GradientStop Color="#00121212" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ListBox Style="{StaticResource TrackList}" ItemsSource="{Binding ListItems}" Padding="16,0,8,16"
                 v:ListBehaviors.ActivateCommand="{Binding PlayCommand}"
                 v:ListBehaviors.EndReachedCommand="{Binding LoadMoreCommand}">
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type vm:PlaylistViewModel}">
                    <StackPanel Margin="8,0,8,0">
                        <!-- Hero -->
                        <Grid Margin="8,56,8,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="200" Height="200" CornerRadius="6" Background="{StaticResource Elevated}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="4" Opacity="0.5" RenderingBias="Performance"/>
                                </Border.Effect>
                                <Grid>
                                    <TextBlock Text="{Binding IsLikedSongs, Converter={StaticResource BoolGlyph}, ConverterParameter=&#xEB52;|&#xE8D6;}"
                                               Style="{StaticResource Glyph}" FontSize="64" Foreground="White"
                                               Visibility="{Binding Info.ThumbnailUrl, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Info.ThumbnailUrl, Converter={StaticResource Thumb}, ConverterParameter=200}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Info.KindLabel}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Info.Title}" Style="{StaticResource Hero}" Margin="0,4,0,10"/>
                                <TextBlock Style="{StaticResource Sub}" Foreground="#E6FFFFFF" FontSize="14">
                                    <Run Text="{Binding Info.Subtitle, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding TrackCountText, Mode=OneWay, StringFormat='  •  {0}'}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="8,0,8,16">
                            <Button Style="{StaticResource AccentPlayButton}" Content="&#xE768;" ToolTip="Play" Command="{Binding PlayAllCommand}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="26" Width="48" Height="48" Margin="16,0,0,0"
                                    ToolTip="Shuffle play" Command="{Binding ShuffleAllCommand}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="22" Width="48" Height="48" Margin="4,0,0,0"
                                    ToolTip="Delete playlist" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=v:ShellView}}"
                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="8,0,8,8"
                                   Visibility="{Binding Error, Converter={StaticResource Vis}}"/>

                        <!-- Column header -->
                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Margin="0,0,0,8" Padding="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource Sub}"/>
                                <TextBlock Grid.Column="2" Text="Album" Style="{StaticResource Sub}"/>
                                <TextBlock Grid.Column="4" Text="&#xE823;" Style="{StaticResource Glyph}" Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Right" Margin="0,0,22,0"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Loading…" Style="{StaticResource Sub}" Margin="8"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="{x:Type api:Track}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TrackRow}"/>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </Grid>
</UserControl>
