<UserControl x:Class="YouTubeMusicNative.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <!-- A home-feed card: art (round for artists), title, subtitle; hover reveals a play button -->
        <DataTemplate x:Key="Card">
            <Button x:Name="CardRoot" Style="{StaticResource CardButton}" Width="184" VerticalAlignment="Top"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=v:HomeView}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Grid Width="160" Height="160">
                        <Border x:Name="Art" CornerRadius="6" Background="{StaticResource Elevated}">
                            <Border x:Name="ArtImage" CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Thumb}, ConverterParameter=160}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>
                        <Button x:Name="CardPlay" Style="{StaticResource AccentPlayButton}" Width="48" Height="48" FontSize="18"
                                Content="&#xE768;" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                                Opacity="0" ToolTip="Play"
                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=v:HomeView}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" FontSize="15" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}" TextWrapping="Wrap" MaxHeight="36" Margin="0,3,0,0"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsArtist}" Value="True">
                    <Setter TargetName="Art" Property="CornerRadius" Value="80"/>
                    <Setter TargetName="ArtImage" Property="CornerRadius" Value="80"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                    <Setter TargetName="CardPlay" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  v:ListBehaviors.EndReachedCommand="{Binding LoadMoreCommand}">
        <Grid>
            <!-- Soft colour wash behind the greeting, tinted by what's playing -->
            <Border Height="320" VerticalAlignment="Top" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{Binding DataContext.Playback.ArtColor, RelativeSource={RelativeSource AncestorType=v:ShellView}}" Offset="0"/>
                        <GradientStop Color="#00121212" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel Margin="12,24,12,24">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" Margin="12,0,12,16"/>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="12,0,12,12"
                           Visibility="{Binding Error, Converter={StaticResource Vis}}"/>

                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,16">
                                <DockPanel Margin="12,0,12,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Style="{StaticResource SmallCircleButton}" Content="&#xE76B;" ToolTip="Scroll left"
                                                v:ListBehaviors.ScrollTarget="{Binding ElementName=Row}" v:ListBehaviors.ScrollDirection="-1"/>
                                        <Button Style="{StaticResource SmallCircleButton}" Content="&#xE76C;" ToolTip="Scroll right" Margin="8,0,0,0"
                                                v:ListBehaviors.ScrollTarget="{Binding ElementName=Row}" v:ListBehaviors.ScrollDirection="1"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Strapline}" Style="{StaticResource Label}" FontSize="11"
                                                   Visibility="{Binding Strapline, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="Row" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Card}"
                                              v:ListBehaviors.BubbleWheel="True"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Loading…" Style="{StaticResource Sub}" Margin="12,8" HorizontalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
