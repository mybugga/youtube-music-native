<UserControl x:Class="YouTubeMusicNative.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="StepNum" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource ElevatedHover}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource Sub}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="Margin" Value="12,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Grows with the window up to a readable width, then stays centred -->
        <StackPanel Margin="40,40,40,40" MaxWidth="980" HorizontalAlignment="Stretch">
            <TextBlock Text="Account &amp; settings" Style="{StaticResource H1}" Margin="0,0,0,24"/>

            <!-- Signed in -->
            <Border Background="{StaticResource Elevated}" CornerRadius="8" Padding="28,24"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile photo (falls back to an icon until it loads / if there is none) -->
                    <Grid Width="96" Height="96" VerticalAlignment="Top" Margin="0,0,24,0">
                        <Ellipse Fill="{StaticResource Accent}"/>
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" FontSize="36" Foreground="Black"/>
                        <Ellipse Visibility="{Binding Account.PhotoUrl, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Account.PhotoUrl, Converter={StaticResource Thumb}, ConverterParameter=96}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SIGNED IN AS" Style="{StaticResource Label}" FontSize="11"/>
                        <TextBlock Text="{Binding Account.Name, TargetNullValue='Your YouTube Music account', FallbackValue='Your YouTube Music account'}"
                                   Style="{StaticResource H2}" FontSize="26" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Account.Handle}" Style="{StaticResource Sub}" FontSize="14" Margin="0,2,0,0"
                                   Visibility="{Binding Account.Handle, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                        <TextBlock Text="Your library, playlists, likes and personal home feed are available."
                                   Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding IsLinkedToBrowser, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12" Foreground="#1ED760"/>
                            <TextBlock Text="{Binding LinkedBrowserName, StringFormat='Linked to {0} · refreshed automatically when the app starts'}" Style="{StaticResource Sub}"
                                       FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                        <Button Style="{StaticResource OutlinePill}" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="20,8"
                                Command="{Binding LogoutCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF3B1;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sign out"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Signed out -->
            <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <!-- Pick how to sign in: Firefox-family browsers (session shared), the Google window, or a cookie -->
                <Border Background="{StaticResource Elevated}" CornerRadius="8" Padding="28,24,28,16">
                    <StackPanel>
                        <TextBlock Text="Sign in to YouTube Music" FontWeight="Bold" FontSize="17"/>
                        <TextBlock Text="Choose how you'd like to sign in." Style="{StaticResource Sub}" FontSize="14" Margin="0,4,0,12"/>

                        <ItemsControl ItemsSource="{Binding SignInOptions}"
                                      Visibility="{Binding IsWaitingForBrowser, Converter={StaticResource Vis}, ConverterParameter=invert}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Padding="12,12" Margin="-12,0"
                                            Command="{Binding DataContext.SignInWithCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Icon" Width="40" Height="40" CornerRadius="20" Background="{StaticResource ElevatedHover}"
                                                    VerticalAlignment="Top" Margin="0,0,16,0">
                                                <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="17"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                                    <Border CornerRadius="9" Padding="8,2" Margin="10,0,0,0" Background="#33FF4E6B" VerticalAlignment="Center"
                                                            Visibility="{Binding Badge, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="13" TextWrapping="Wrap"
                                                           TextTrimming="None" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="12"
                                                       Foreground="{StaticResource TextDim}" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Badge, Converter={StaticResource Vis}}" Value="Visible">
                                            <Setter TargetName="Icon" Property="Background" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="IconGlyph" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Waiting for the browser -->
                        <Border Margin="0,8,0,8" Padding="16,12" CornerRadius="8" Background="#14FFFFFF"
                                Visibility="{Binding IsWaitingForBrowser, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource OutlinePill}" Content="Cancel" Margin="20,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding CancelBrowserSignInCommand}"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WaitingBrowserName, StringFormat='Waiting for you to sign in in {0}…'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Finish signing in there; this page updates by itself." Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Elevated}" CornerRadius="8" Padding="24,20" Margin="0,16,0,0"
                        Visibility="{Binding ShowManual, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Copy your cookie" FontWeight="Bold" FontSize="15" Margin="0,0,0,16"/>
                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource StepNum}"><TextBlock Text="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Style="{StaticResource StepText}" Text="Open music.youtube.com in your browser and make sure you're signed in."/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource StepNum}"><TextBlock Text="2" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Style="{StaticResource StepText}" Text="Press F12, open the Network tab and click any request to music.youtube.com (for example &quot;browse&quot;)."/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,18">
                            <Border Style="{StaticResource StepNum}"><TextBlock Text="3" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Style="{StaticResource StepText}" Text="Under Request Headers, copy the whole value of &quot;cookie&quot; and paste it below."/>
                        </DockPanel>

                        <TextBox Style="{StaticResource InputBox}" Height="110" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 Text="{Binding CookieText, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource PillButton}" Content="Sign in" Margin="0,0,12,0" Command="{Binding LoginCommand}"/>
                            <Button Style="{StaticResource OutlinePill}" Content="Import cookies.txt…" Command="{Binding ImportFileCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="14"
                       Visibility="{Binding Message, Converter={StaticResource Vis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ============================================================ Settings (app-wide, not the account) -->
            <StackPanel Margin="0,40,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=v:ShellView}}">
                <TextBlock Text="Settings" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                <Border Background="{StaticResource Elevated}" CornerRadius="8" Padding="24,8">
                    <StackPanel>
                        <DockPanel Margin="0,14">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding CloseToTray}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Keep playing in the tray when closed" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="The close button hides the app to the notification area instead of quitting."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding StartWithWindows}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Opens when you sign in to Windows, the way you left it: the full window, the mini player, or just the tray icon."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding ResumePlaybackOnStart}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Continue playing on startup" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="If music was playing when the app closed, it carries on with the same song, position and queue."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Playback.Autoplay}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Autoplay similar songs" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="When your queue runs out, keeps going with songs like the last one."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding SmoothAnimations}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Smooth animations" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Eased scrolling, sliding pages and dialogs, fading highlights and a smoothly moving progress bar, drawn by the graphics card at your screen's refresh rate. Uses about 40 MB more memory; the full effect applies the next time the app starts."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14"
                                   IsEnabled="{Binding SmoothAnimations, Converter={StaticResource Not}}">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding LowMemoryRendering}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Use less memory" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Draws the app with the processor instead of the graphics card, which saves about 40 MB. Not used while smooth animations are on. Applies the next time the app starts."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource OutlinePill}" Content="Clear cache" VerticalAlignment="Center"
                                    Padding="14,6" Command="{Binding ClearCacheCommand}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Cached library" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="A copy of your YouTube playlists kept on this PC, so they stay playable when you're signed out or offline (tagged Cached). Local playlists aren't affected."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Updates.CheckForUpdates}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Check for updates automatically" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Looks for new releases on GitHub every few hours and downloads them in the background."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Updates.InstallOnExit}"/>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Install updates automatically" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="A downloaded update installs quietly the next time the app closes or starts."
                                           Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="#1AFFFFFF"/>
                        <DockPanel Margin="0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource AccentPill}" Content="Restart to update" Padding="16,7" FontSize="13"
                                        Command="{Binding Updates.RestartToUpdateCommand}"
                                        Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource BoolVis}}"/>
                                <Button Style="{StaticResource OutlinePill}" Content="Check now" Margin="10,0,0,0"
                                        Command="{Binding Updates.CheckNowCommand}"
                                        Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock FontWeight="SemiBold" FontSize="14"
                                           Text="{Binding Updates.CurrentVersionText, StringFormat='YouTube Music Native {0}'}"/>
                                <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None"
                                           Margin="0,3,0,0" Visibility="{Binding Updates.Status, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
