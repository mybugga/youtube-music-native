<UserControl x:Class="YouTubeMusicNative.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views"
             xmlns:vm="clr-namespace:YouTubeMusicNative.ViewModels"
             Background="{StaticResource Bg}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><v:SearchView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistViewModel}"><v:PlaylistView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}"><v:NowPlayingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView/></DataTemplate>
        <!-- ======================================================== Dialog cards -->
        <Style x:Key="DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:AddToPlaylistDialog}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                            ToolTip="Close" Command="{Binding CloseCommand}"/>
                    <TextBlock Text="Add to playlist" Style="{StaticResource DialogTitle}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,16">
                    <Run Text="{Binding Track.Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="White"/>
                    <Run Text="{Binding Track.Artists, Mode=OneWay, StringFormat='  •  {0}'}"/>
                </TextBlock>

                <Button Style="{StaticResource RowButton}" Command="{Binding NewPlaylistCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="4" Background="{StaticResource ElevatedHover}">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="18"/>
                        </Border>
                        <TextBlock Text="New playlist" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Button>

                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="4" Background="{StaticResource ElevatedHover}">
                                            <Grid>
                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource TextFaint}"/>
                                                <Border CornerRadius="4">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Thumb}, ConverterParameter=44}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" FontWeight="Normal" FontSize="15"/>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}" Margin="0,2,0,0"
                                                       Visibility="{Binding Subtitle, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" Margin="8,12,0,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                    <v:Spinner Width="16" Height="16" Thickness="2"/>
                    <TextBlock Text="Loading your playlists…" Style="{StaticResource Sub}" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Text="You don't have any playlists yet. Create one above." Style="{StaticResource Sub}" Margin="8,12,0,4"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="8,12,0,0"
                           Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CreatePlaylistDialog}">
            <StackPanel FocusManager.FocusedElement="{Binding ElementName=TitleBox}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                            ToolTip="Close" Command="{Binding CloseCommand}"/>
                    <TextBlock Text="New playlist" Style="{StaticResource DialogTitle}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Visibility="{Binding FirstSong, Converter={StaticResource Vis}}">
                    <Run Text="Starting with"/>
                    <Run Text="{Binding FirstSong.Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="White"/>
                </TextBlock>

                <TextBlock Text="Title" Style="{StaticResource Label}" Margin="0,18,0,6"/>
                <Grid>
                    <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}" MaxLength="150"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreateCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="My playlist" Style="{StaticResource Sub}" FontSize="14" Margin="27,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="{Binding Title, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                </Grid>

                <TextBlock Text="Description (optional)" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                <TextBox Style="{StaticResource InputBox}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="5000"
                         VerticalScrollBarVisibility="Auto" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Privacy" Style="{StaticResource Label}" Margin="0,14,0,8"/>
                <ItemsControl ItemsSource="{Binding PrivacyOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Option" Style="{StaticResource OutlinePill}" Content="{Binding}" Margin="0,0,8,0" Padding="16,6"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SetPrivacyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                                            <Binding/>
                                            <Binding Path="DataContext.Privacy" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Option" Property="Style" Value="{StaticResource PillButton}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding Error, Converter={StaticResource Vis}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <v:Spinner Width="18" Height="18" Thickness="2" Margin="0,0,14,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    <Button Style="{StaticResource OutlinePill}" Content="Cancel" Command="{Binding CloseCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PillButton}" Content="Create" Padding="22,8" Command="{Binding CreateCommand}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConfirmDialog}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Sub}" FontSize="14" TextWrapping="Wrap" TextTrimming="None"
                           LineHeight="21" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <v:Spinner Width="18" Height="18" Thickness="2" Margin="0,0,14,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    <Button Style="{StaticResource OutlinePill}" Content="Cancel" Command="{Binding CloseCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource AccentPill}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ Title bar -->
        <Grid x:Name="TitleBar" Background="Transparent">
            <!-- Search sits in the middle and shrinks on narrow windows instead of running under the buttons. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="244"/>
                <ColumnDefinition Width="4*" MaxWidth="480"/>
                <ColumnDefinition Width="*" MinWidth="232"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Grid Width="28" Height="28">
                    <Ellipse Fill="{StaticResource Accent}"/>
                    <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="11" Foreground="White" Margin="2,0,0,0"/>
                </Grid>
                <TextBlock Text="YouTube Music" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,1"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Margin="16,0,0,0" ToolTip="Go back"
                        Command="{Binding GoBackCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Margin="2,0,0,0" ToolTip="Go forward"
                        Command="{Binding GoForwardCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Grid Height="46" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" GotKeyboardFocus="OnSearchFocused"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand, RelativeSource={RelativeSource AncestorType=v:ShellView}}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" HorizontalAlignment="Right" Margin="0,0,8,0"
                            ToolTip="Clear" Click="OnClearSearch"
                            Visibility="{Binding SearchText, Converter={StaticResource Vis}}"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <!-- A downloaded update: one click installs it and reopens the app. -->
                <Button Style="{StaticResource AccentPill}" Padding="12,5" Margin="0,18,10,0" VerticalAlignment="Top" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding Updates.RestartToUpdateCommand}"
                        Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource BoolVis}}">
                    <Button.ToolTip>
                        <TextBlock Text="{Binding Updates.ReadyVersion, StringFormat='Version {0} is ready. Restart the app to update.'}"/>
                    </Button.ToolTip>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Update"/>
                    </StackPanel>
                </Button>
                <Grid VerticalAlignment="Center" Margin="0,14,12,0">
                <Button WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{Binding Login.Account.Name, TargetNullValue=Account, FallbackValue=Account}"
                        Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Account}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CircleButton}">
                            <Setter Property="Width" Value="36"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Content" Value="&#xE77B;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Profile photo over the button; clicks pass through to it. -->
                <Ellipse Width="32" Height="32" IsHitTestVisible="False"
                         Visibility="{Binding Login.Account.PhotoUrl, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Login.Account.PhotoUrl, Converter={StaticResource Thumb}, ConverterParameter=32}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                </Grid>
                <Button Style="{StaticResource WindowButton}" Content="&#xE73F;" ToolTip="Mini player"
                        Command="{Binding ShowMiniPlayerCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimize"
                        Command="{x:Static SystemCommands.MinimizeWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button ToolTip="Maximize" Command="{x:Static SystemCommands.MaximizeWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                            <Setter Property="Content" Value="&#xE922;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;"/>
                                    <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
                                    <Setter Property="ToolTip" Value="Restore"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close"
                        Command="{x:Static SystemCommands.CloseWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- ============================================================ Panels -->
        <Grid Grid.Row="1" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <v:LibraryPanel Width="300" Margin="0,0,8,0">
                <v:LibraryPanel.Style>
                    <Style TargetType="v:LibraryPanel">
                        <Style.Triggers>
                            <!-- Now Playing takes the full width -->
                            <DataTrigger Binding="{Binding CurrentPageKind}" Value="{x:Static vm:AppPage.NowPlaying}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </v:LibraryPanel.Style>
            </v:LibraryPanel>

            <!-- Main page -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" v:RoundedClip.Radius="8">
                <Grid>
                    <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>

                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,20"
                            Background="#F2FFFFFF" CornerRadius="8" Padding="16,10" MaxWidth="560"
                            Visibility="{Binding Playback.StatusMessage, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Playback.StatusMessage}" TextWrapping="Wrap" Foreground="Black" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <v:QueuePanel Grid.Column="2" Width="340" Margin="8,0,0,0" DataContext="{Binding Queue}"
                          Visibility="{Binding DataContext.IsQueueOpen, RelativeSource={RelativeSource AncestorType=v:ShellView}, Converter={StaticResource BoolVis}}"/>
        </Grid>

        <!-- ============================================================ Player -->
        <v:NowPlayingBar Grid.Row="2"/>

        <!-- ============================================================ Dialog -->
        <Grid Grid.RowSpan="3" Visibility="{Binding Dialog, Converter={StaticResource Vis}}" Background="#B3000000"
              MouseLeftButtonDown="OnDialogBackdropClick">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}"/>
            </Grid.InputBindings>
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                    Background="{StaticResource Elevated}" CornerRadius="12" Padding="24,20,24,22"
                    MouseLeftButtonDown="OnDialogCardClick">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.6" RenderingBias="Performance"/>
                </Border.Effect>
                <ContentControl Content="{Binding Dialog}" Focusable="False"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
