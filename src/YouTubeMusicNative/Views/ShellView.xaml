<UserControl x:Class="YouTubeMusicNative.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views"
             xmlns:vm="clr-namespace:YouTubeMusicNative.ViewModels"
             xmlns:s="clr-namespace:YouTubeMusicNative.Services"
             Background="{StaticResource Bg}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><v:SearchView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistViewModel}"><v:PlaylistView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArtistViewModel}"><v:ArtistView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}"><v:NowPlayingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView/></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ Title bar -->
        <Grid x:Name="TitleBar" Background="Transparent">
            <!-- Search sits in the middle and shrinks on narrow windows instead of running under the buttons. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="244"/>
                <ColumnDefinition Width="4*" MaxWidth="480"/>
                <ColumnDefinition Width="*" MinWidth="232"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <!-- The logo, live: its bars bounce like an equalizer while music plays -->
                <v:LiveLogo Width="28" Height="28" Playback="{Binding Playback}"/>
                <TextBlock Text="YouTube Music" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,1"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Margin="16,0,0,0" ToolTip="Go back"
                        Command="{Binding GoBackCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Margin="2,0,0,0" ToolTip="Go forward"
                        Command="{Binding GoForwardCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Grid Height="46" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" GotKeyboardFocus="OnSearchFocused"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand, RelativeSource={RelativeSource AncestorType=v:ShellView}}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" HorizontalAlignment="Right" Margin="0,0,8,0"
                            ToolTip="Clear" Click="OnClearSearch"
                            Visibility="{Binding SearchText, Converter={StaticResource Vis}}"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <!-- An update downloading in the background: a small progress ring and percentage. -->
                <Border Margin="0,18,10,0" VerticalAlignment="Top" Height="28" CornerRadius="14" Padding="8,0,12,0"
                        Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        WindowChrome.IsHitTestVisibleInChrome="True" v:Motion.EnterFrom="18,0"
                        Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolVis}}">
                    <Border.ToolTip>
                        <TextBlock Text="{Binding Updates.DownloadingVersion, StringFormat='Downloading version {0} in the background'}"/>
                    </Border.ToolTip>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <v:ProgressArc Width="16" Height="16" Thickness="2" Stroke="{StaticResource Accent}" Track="#33FFFFFF"
                                       Value="{Binding Updates.DownloadProgress}"/>
                        <TextBlock Text="Downloading update" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Updates.DownloadPercent}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MinWidth="30" TextOptions.TextFormattingMode="Display"/>
                    </StackPanel>
                </Border>
                <!-- A downloaded update: one click installs it and reopens the app. It slides in, then pulses a few times. -->
                <Grid Margin="0,18,10,0" VerticalAlignment="Top" v:Motion.EnterFrom="18,0"
                      Visibility="{Binding Updates.IsUpdateReady, Converter={StaticResource BoolVis}}">
                    <Border CornerRadius="16" Background="{StaticResource Accent}" IsHitTestVisible="False" v:Motion.Pulse="True"/>
                    <Button Style="{StaticResource AccentPill}" Padding="12,5" FontSize="12"
                            WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding Updates.RestartToUpdateCommand}">
                        <Button.ToolTip>
                            <TextBlock Text="{Binding Updates.ReadyVersion, StringFormat='Version {0} is ready. Click to restart and update.'}"/>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Updates.ReadyVersion, StringFormat='Update to {0}'}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Account & settings: a gear (the gear turns a little on hover). -->
                <Button WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Margin="0,14,12,0"
                        ToolTip="Account &amp; settings" AutomationProperties.Name="Account and settings"
                        Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Account}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CircleButton}">
                            <Setter Property="Width" Value="36"/>
                            <Setter Property="Height" Value="36"/>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="Gear" Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="16"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Gear" Storyboard.TargetProperty="RenderTransform.Angle"
                                                     To="60" Duration="0:0:0.35">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Gear" Storyboard.TargetProperty="RenderTransform.Angle"
                                                     To="0" Duration="0:0:0.35">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
                <Button Style="{StaticResource WindowButton}" Content="&#xE73F;" ToolTip="Mini player"
                        Command="{Binding ShowMiniPlayerCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimize"
                        Command="{x:Static SystemCommands.MinimizeWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button ToolTip="Maximize" Command="{x:Static SystemCommands.MaximizeWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                            <Setter Property="Content" Value="&#xE922;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content" Value="&#xE923;"/>
                                    <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
                                    <Setter Property="ToolTip" Value="Restore"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close"
                        Command="{x:Static SystemCommands.CloseWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- ============================================================ Panels -->
        <Grid Grid.Row="1" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <v:LibraryPanel Width="300" Margin="0,0,8,0">
                <v:LibraryPanel.Style>
                    <Style TargetType="v:LibraryPanel">
                        <Style.Triggers>
                            <!-- Now Playing takes the full width -->
                            <DataTrigger Binding="{Binding CurrentPageKind}" Value="{x:Static vm:AppPage.NowPlaying}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </v:LibraryPanel.Style>
            </v:LibraryPanel>

            <!-- Main page -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" v:RoundedClip.Radius="8">
                <Grid>
                    <ContentControl Content="{Binding CurrentPage}" Focusable="False" v:Motion.PageTransition="True"/>

                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,20"
                            Background="#F2FFFFFF" CornerRadius="8" Padding="16,10" MaxWidth="560"
                            Visibility="{Binding Playback.StatusMessage, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Playback.StatusMessage}" TextWrapping="Wrap" Foreground="Black" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <v:QueuePanel Grid.Column="2" Width="340" Margin="8,0,0,0" DataContext="{Binding Queue}"
                          Visibility="{Binding DataContext.IsQueueOpen, RelativeSource={RelativeSource AncestorType=v:ShellView}, Converter={StaticResource BoolVis}}"/>
        </Grid>

        <!-- ============================================================ Offline -->
        <!-- Covers the panels while YouTube can't be reached; fades away by itself once the connection is back. -->
        <Border Grid.Row="1" Margin="8,0,8,0" CornerRadius="8" Background="#F2121212" Opacity="0" IsHitTestVisible="False"
                DataContext="{x:Static s:Connectivity.Instance}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="True"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Fill="{StaticResource Elevated}"/>
                    <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" FontSize="34" Foreground="{StaticResource TextDim}"/>
                </Grid>
                <TextBlock Text="You're offline" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                <TextBlock Text="Check your internet connection. Everything reloads by itself as soon as you're back online."
                           Style="{StaticResource Sub}" FontSize="14" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"
                           LineHeight="21" Margin="0,8,0,0"/>
                <!-- Reconnecting: three dots hopping in turn (animated only while offline) -->
                <v:LoadingDots Fill="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,26,0,0"
                               Visibility="{Binding IsOffline, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="Reconnecting" Style="{StaticResource Sub}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ Player -->
        <v:NowPlayingBar Grid.Row="2"/>

        <!-- ============================================================ Updated (first start after an update) -->
        <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,14,16,0" Panel.ZIndex="5"
                Background="{StaticResource Elevated}" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,10,8,10"
                v:Motion.EnterFrom="0,-28"
                Visibility="{Binding Updates.JustUpdatedTo, Converter={StaticResource Vis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" RenderingBias="Performance"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Grid Width="28" Height="28" VerticalAlignment="Center">
                    <Ellipse Fill="#1ED760"/>
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="12,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Updates.JustUpdatedTo, StringFormat='Updated to version {0}'}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="You're on the latest YouTube Music Native." Style="{StaticResource Sub}" FontSize="12" Margin="0,1,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource OutlinePill}" Content="What's new" FontSize="12" Padding="12,5" VerticalAlignment="Center"
                        Command="{Binding Updates.OpenReleaseNotesCommand}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="30" Height="30" Margin="4,0,0,0"
                        VerticalAlignment="Center" ToolTip="Dismiss" Command="{Binding Updates.DismissUpdatedCommand}"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ Updating (after "Update to …") -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="20" Background="#F20A0A0A" v:Motion.EnterFrom="0,0"
              Visibility="{Binding Updates.IsInstalling, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" v:Motion.EnterFrom="0,16">
                <!-- The logo's three bars, dancing like an equalizer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="64">
                    <Rectangle Width="14" Height="40" RadiusX="7" RadiusY="7" Fill="#E8213A" VerticalAlignment="Bottom" Margin="5,0" v:Motion.Bounce="0"/>
                    <Rectangle Width="14" Height="64" RadiusX="7" RadiusY="7" Fill="#FF3355" VerticalAlignment="Bottom" Margin="5,0" v:Motion.Bounce="160"/>
                    <Rectangle Width="14" Height="50" RadiusX="7" RadiusY="7" Fill="#C8102E" VerticalAlignment="Bottom" Margin="5,0" v:Motion.Bounce="320"/>
                </StackPanel>
                <TextBlock Text="{Binding Updates.ReadyVersion, StringFormat='Updating to version {0}'}" Style="{StaticResource H2}"
                           HorizontalAlignment="Center" Margin="0,26,0,0"/>
                <TextBlock Text="The app closes for a moment and opens again by itself." Style="{StaticResource Sub}" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ============================================================ Dialog -->
        <Grid Grid.RowSpan="3" Visibility="{Binding Dialog, Converter={StaticResource Vis}}" Background="#B3000000"
              MouseLeftButtonDown="OnDialogBackdropClick">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}"/>
            </Grid.InputBindings>
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                    Background="{StaticResource Elevated}" CornerRadius="12" Padding="24,20,24,22"
                    MouseLeftButtonDown="OnDialogCardClick" v:Motion.PopIn="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.6" RenderingBias="Performance"/>
                </Border.Effect>
                <ContentControl Content="{Binding Dialog}" Focusable="False"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
