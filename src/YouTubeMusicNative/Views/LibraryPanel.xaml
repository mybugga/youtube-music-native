<UserControl x:Class="YouTubeMusicNative.Views.LibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YouTubeMusicNative.ViewModels"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views">
    <!-- DataContext: MainViewModel -->
    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Home / Search -->
        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Home}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Setter Property="Tag" Value="&#xE80F;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPageKind}" Value="{x:Static vm:AppPage.Home}">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Tag" Value="&#xEA8A;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Style="{StaticResource Glyph}" FontSize="20" Width="24"/>
                            <TextBlock Text="Home" FontSize="15" FontWeight="Bold" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
            </StackPanel>
        </Border>

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="20,16,12,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="14"
                        ToolTip="Refresh library" Command="{Binding Library.RefreshCommand}"
                        Visibility="{Binding Library.IsLoggedIn, Converter={StaticResource BoolVis}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="15"
                        ToolTip="Create playlist" Command="{Binding CreatePlaylistCommand}" Margin="0,0,2,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8B5;" FontSize="15"
                        ToolTip="Import playlist from file" Command="{Binding ImportPlaylistCommand}" Margin="0,0,2,0"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{StaticResource TextDim}"/>
                    <TextBlock Text="Your Library" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1">
            <!-- Signed out: local playlists still work; this offers the YouTube library -->
            <Border DockPanel.Dock="Top" Margin="8,0,8,8" Background="{StaticResource Elevated}" CornerRadius="8" Padding="16,14"
                    Visibility="{Binding Library.IsLoggedIn, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="Sign in for your YouTube library" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock Text="Playlists and likes you make now stay on this PC." Style="{StaticResource Sub}"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,12"/>
                    <Button Style="{StaticResource PillButton}" Content="Sign in" HorizontalAlignment="Left" Padding="16,6" FontSize="13"
                            Command="{Binding SignInCommand}"/>
                </StackPanel>
            </Border>

            <!-- Playlists -->
            <ItemsControl ItemsSource="{Binding Library.Playlists}" Margin="8,0,4,8"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Row" Style="{StaticResource RowButton}"
                                Command="{Binding DataContext.Library.OpenCommand, RelativeSource={RelativeSource AncestorType=v:LibraryPanel}}"
                                CommandParameter="{Binding}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=v:LibraryPanel}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Tag="&#xE8A7;" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.Library.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Delete playlist" Tag="&#xE74D;" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding CanDelete, Converter={StaticResource BoolVis}}"/>
                                    <MenuItem Header="Remove from your library" Tag="&#xE738;" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding CanRemoveFromLibrary, Converter={StaticResource BoolVis}}"/>
                                    <Separator/>
                                    <MenuItem Header="Copy to this PC" Tag="&#xE977;" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.CopyToLocalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding IsLocal, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                    <MenuItem Header="Upload to YouTube Music" Tag="&#xE898;" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.UploadToYouTubeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Style>
                                            <!-- Only for a local playlist while signed in -->
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsLocal}" Value="True"/>
                                                            <Condition Value="True"
                                                                       Binding="{Binding PlacementTarget.Tag.Library.IsLoggedIn, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Export to file…" Tag="&#xE78C;" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.ExportPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- No art: a note on a plain tile; Liked Music gets its gradient heart tile -->
                                <Border Width="48" Height="48" CornerRadius="4" Background="{StaticResource ElevatedHover}">
                                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource TextFaint}"/>
                                </Border>
                                <Border x:Name="LikedTile" Width="48" Height="48" CornerRadius="4" Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5B2BE0" Offset="0"/>
                                            <GradientStop Color="#C4E0F0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="&#xEB52;" Style="{StaticResource Glyph}" FontSize="18" Foreground="White"/>
                                </Border>
                                <Border Width="48" Height="48" CornerRadius="4" Background="{StaticResource Elevated}"
                                        Visibility="{Binding ThumbnailUrl, Converter={StaticResource Vis}}">
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Thumb}, ConverterParameter=48}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Name" Text="{Binding Title}" Style="{StaticResource Title}" FontWeight="Normal" FontSize="15"/>
                                    <DockPanel Margin="0,3,0,0">
                                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource TagBadge}" Content="{Binding Tag}"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding PlaylistId}" Value="LM">
                                <Setter TargetName="LikedTile" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PlaylistId}" Value="local:liked">
                                <Setter TargetName="LikedTile" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EqualsMulti}">
                                        <Binding Path="BrowseId"/>
                                        <Binding Path="DataContext.CurrentPlaylistId" RelativeSource="{RelativeSource AncestorType=v:LibraryPanel}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowSelected}"/>
                                <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="{Binding Library.Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                       Margin="20,8" VerticalAlignment="Bottom" Visibility="{Binding Library.Error, Converter={StaticResource Vis}}"/>
        </Grid>
    </Border>
    </Grid>
</UserControl>
