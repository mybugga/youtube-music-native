<UserControl x:Class="YouTubeMusicNative.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views"
             xmlns:vm="clr-namespace:YouTubeMusicNative.ViewModels"
             xmlns:api="clr-namespace:YouTubeMusicNative.Api"
             Style="{StaticResource PageRoot}">
    <Grid>
        <ListBox Style="{StaticResource TrackList}" ItemsSource="{Binding ListItems}" Padding="16,0,8,16"
                 v:ListBehaviors.ActivateCommand="{Binding PlayCommand}"
                 v:ListBehaviors.EndReachedCommand="{Binding LoadMoreCommand}"
                 Visibility="{Binding ShowResults, Converter={StaticResource BoolVis}}">
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                    <StackPanel Margin="8,24,8,8">
                        <!-- Top result: the artist (or album / playlist) YouTube matched, like YouTube Music's big card -->
                        <Border Background="{StaticResource Elevated}" CornerRadius="10" Margin="0,0,0,28" MaxWidth="760"
                                HorizontalAlignment="Left" Visibility="{Binding TopResult, Converter={StaticResource Vis}}">
                            <Button Style="{StaticResource RowButton}" Padding="18" Command="{Binding OpenTopResultCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="TopArt" Width="104" Height="104" CornerRadius="52" Background="{StaticResource ElevatedHover}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.5" RenderingBias="Performance"/>
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TopResult.IsArtist}" Value="False">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border CornerRadius="{Binding CornerRadius, ElementName=TopArt}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding TopResult.ThumbnailUrl, Converter={StaticResource Thumb}, ConverterParameter=104}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="22,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TopResult.Title}" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TopResult.Subtitle}" Style="{StaticResource Sub}" FontSize="14" Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Style="{StaticResource PillButton}" Padding="18,7" Command="{Binding PlayTopResultCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Play"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource OutlinePill}" Padding="18,7" Margin="10,0,0,0" Command="{Binding OpenTopResultCommand}">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Open"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TopResult.IsArtist}" Value="True">
                                                                    <Setter Property="Text" Value="View artist"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                        <TextBlock Text="Songs" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Margin="0,16,0,8" Padding="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource Sub}"/>
                                <TextBlock Grid.Column="2" Text="Album" Style="{StaticResource Sub}"/>
                                <TextBlock Grid.Column="4" Text="&#xE823;" Style="{StaticResource Glyph}" Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Right" Margin="0,0,22,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="{x:Type api:Track}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TrackRow}"/>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>

        <!-- Recent searches (empty search box) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowRecent, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="32,28,32,24" MaxWidth="760" HorizontalAlignment="Stretch">
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlinePill}" Content="Clear all" Padding="14,5" FontSize="12"
                            VerticalAlignment="Center" Command="{Binding ClearRecentCommand}"/>
                    <TextBlock Text="Recent searches" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding RecentSearches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Row" Style="{StaticResource RowButton}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.UseRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource ElevatedHover}">
                                        <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="15" Margin="14,0,8,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="Remove" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                                            ToolTip="Remove from recent searches" Foreground="{StaticResource TextFaint}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                                    <Setter TargetName="Remove" Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Nothing searched yet -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowIntro, Converter={StaticResource BoolVis}}">
            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="48" Foreground="{StaticResource TextFaint}"/>
            <TextBlock Text="Search YouTube Music" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,20,0,6"/>
            <TextBlock Text="Type in the search bar above. Right-click any song for queue options." Style="{StaticResource Sub}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Loading bar (static on purpose: endless animations keep WPF's render loop busy) -->
        <Border VerticalAlignment="Top" Height="2" Background="{StaticResource Accent}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
    </Grid>
</UserControl>
