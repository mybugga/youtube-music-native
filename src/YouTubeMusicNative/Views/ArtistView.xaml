<UserControl x:Class="YouTubeMusicNative.Views.ArtistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:YouTubeMusicNative.Views"
             xmlns:vm="clr-namespace:YouTubeMusicNative.ViewModels"
             xmlns:api="clr-namespace:YouTubeMusicNative.Api"
             Style="{StaticResource PageRoot}">
    <ListBox Style="{StaticResource TrackList}" ItemsSource="{Binding ListItems}" Padding="0,0,8,24"
             v:ListBehaviors.ActivateCommand="{Binding PlayCommand}">
        <ListBox.Resources>
            <!-- Header: banner, name, audience, Shuffle / Mix, then the "Top songs" title -->
            <DataTemplate DataType="{x:Type vm:ArtistViewModel}">
                <StackPanel>
                    <Grid Height="340">
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{Binding HeaderColor}" Offset="0"/>
                                    <GradientStop Color="#121212" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Image Source="{Binding BannerUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Fade the banner into the page -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33121212" Offset="0"/>
                                    <GradientStop Color="#66121212" Offset="0.45"/>
                                    <GradientStop Color="#FF121212" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,8">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Hero}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Audience}" Style="{StaticResource Sub}" FontSize="14" Foreground="#D9FFFFFF" Margin="0,6,0,0"
                                       Visibility="{Binding Audience, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" FontSize="13" Margin="0,8,0,0" MaxWidth="720"
                                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Description, Converter={StaticResource Vis}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource PillButton}" Padding="20,8" Command="{Binding ShuffleCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B1;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Shuffle"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource OutlinePill}" Padding="20,8" Margin="10,0,0,0" Command="{Binding MixCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE93E;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Mix"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="32,8"
                               Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="Loading…" Style="{StaticResource Sub}" Margin="32,8"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

                    <DockPanel Margin="32,20,24,8" Visibility="{Binding Tracks.Count, Converter={StaticResource Vis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlinePill}" Content="Show all" Padding="14,5" FontSize="12"
                                VerticalAlignment="Center" Command="{Binding ShowAllCommand}"
                                Visibility="{Binding HasShowAll, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="Top songs" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type api:Track}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TrackRow}" Margin="16,0,0,0"/>
            </DataTemplate>

            <!-- After the top songs: albums, singles, videos, playlists, similar artists -->
            <DataTemplate DataType="{x:Type vm:ArtistShelves}">
                <ItemsControl ItemsSource="{Binding Artist.Sections}" Focusable="False" Margin="12,16,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,16">
                                <DockPanel Margin="12,0,12,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Style="{StaticResource SmallCircleButton}" Content="&#xE76B;" ToolTip="Scroll left"
                                                v:ListBehaviors.ScrollTarget="{Binding ElementName=Row}" v:ListBehaviors.ScrollDirection="-1"/>
                                        <Button Style="{StaticResource SmallCircleButton}" Content="&#xE76C;" ToolTip="Scroll right" Margin="8,0,0,0"
                                                v:ListBehaviors.ScrollTarget="{Binding ElementName=Row}" v:ListBehaviors.ScrollDirection="1"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                                </DockPanel>
                                <ItemsControl x:Name="Row" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Card}"
                                              v:ListBehaviors.BubbleWheel="True"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="True">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </ListBox.Resources>
    </ListBox>
</UserControl>
